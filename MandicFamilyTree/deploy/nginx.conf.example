# Example nginx site config. Copy to /etc/nginx/sites-available/family-tree,
# symlink into sites-enabled, replace the domain below, then run
# `certbot --nginx -d familytree.example.com` to add HTTPS (certbot rewrites
# this file in place to add the server { listen 443 ... } block).
#
# Note: the frontend uses HashRouter (routes live after a # in the URL,
# which the browser never sends to the server), so there's no SPA
# try_files fallback needed — every path serves the same static files.

server {
    listen 80;
    server_name familytree.example.com;

    root /opt/family-tree/dist;
    index index.html;

    # Static frontend build (React + Vite)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploaded photos/documents
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000/uploads/;
        proxy_set_header Host $host;
    }

    client_max_body_size 12m; # a little above the API's own 10MB upload cap
}
